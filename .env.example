# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Without the Firebase keys the game runs exactly as before, with no leaderboards.

# Leaderboards and usernames are on whenever Firebase is set up; set to "off" to hide them.
NEXT_PUBLIC_LEADERBOARD=on
# Google sign-in and cloud saves are switched off unless this is "on".
NEXT_PUBLIC_ACCOUNTS=off

# Firebase web app (Firebase console → Project settings → General → Your apps → Web app config). Public.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Project settings → Service accounts → Generate new private key). Secret.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value as one line with literal \n, wrapped in quotes.
FIREBASE_PRIVATE_KEY=
