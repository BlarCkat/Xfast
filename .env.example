# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Accounts are switched off unless this is "on": no sign-in, cloud saves, leaderboards or coin packs,
# and the game runs guest-only exactly as before. The Firebase keys below are needed too.
NEXT_PUBLIC_ACCOUNTS=off

# Firebase web app (Firebase console → Project settings → General → Your apps → Web app config). Public.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Project settings → Service accounts → Generate new private key). Secret.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value as one line with literal \n, wrapped in quotes.
FIREBASE_PRIVATE_KEY=

# Lemon Squeezy (Settings → API, Settings → Stores, Settings → Webhooks). Secret.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant ID of each coin pack product (see src/game/coinPacks.ts).
LEMONSQUEEZY_VARIANT_POCKET=
LEMONSQUEEZY_VARIANT_BAG=
LEMONSQUEEZY_VARIANT_CHEST=
